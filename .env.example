# Public feed adapters are opt-in. Never commit real keys or tokens.
PHISHTANK_ENABLED=false
PHISHTANK_APP_KEY=
PHISHTANK_REQUIRE_APP_KEY=false
PHISHTANK_USER_AGENT=hecavex-radar/your-github-handle

# OpenPhish requires acceptance of its current Terms of Use.
OPENPHISH_ENABLED=false
OPENPHISH_ACCEPT_TERMS=false

# VMRay's public phishing page is parsed only after you review and accept its
# current access and redistribution terms.
VMRAY_ENABLED=false
VMRAY_ACCEPT_TERMS=false
VMRAY_PAGES=1

# Recent daily CertStream candidate archives included by the Python sync command.
CERTSTREAM_ARCHIVE_ENABLED=true
RADAR_CT_LOOKBACK_DAYS=7

# CertStream collector. A duration of 0 runs continuously; GitHub uses 240.
CERTSTREAM_URL=
CERTSTREAM_ALLOW_INSECURE_WS=false
CERTSTREAM_DURATION_SECONDS=0
CERTSTREAM_FLUSH_SECONDS=15
CERTSTREAM_IDLE_SECONDS=90
CERTSTREAM_REQUIRE_MESSAGES=false
CERTSTREAM_MIN_CONFIDENCE=65
CERTSTREAM_ARCHIVE_ROOT=data/candidates

# Optional machine-to-machine endpoint that returns the public export contract.
HECAVEX_FEED_URL=
HECAVEX_FEED_TOKEN=

# Only screenshot URLs on these HTTPS hosts are published.
RADAR_SCREENSHOT_HOSTS=urlscan.io
RADAR_MAX_SIGNALS=2500
RADAR_MIN_SIGNALS=1
RADAR_MIN_RETAINED_PERCENT=25
RADAR_ALLOW_SMALL_SNAPSHOT=false
RADAR_OUTPUT=public/data/radar.json
