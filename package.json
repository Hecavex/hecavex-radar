{
  "name": "hecavex-radar",
  "version": "0.1.0",
  "private": true,
  "description": "A safe, read-only dashboard for recently observed phishing signals.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "collect:certstream": "python -m hecavex_radar.collect_certstream",
    "hunt:urlscan": "python -m hecavex_radar.urlscan",
    "sync": "python -m hecavex_radar.sync",
    "lint:frontend": "eslint . --max-warnings=0",
    "lint:python": "python -m ruff check hecavex_radar tests_python",
    "lint": "pnpm lint:python && pnpm lint:frontend",
    "typecheck:frontend": "tsc --noEmit",
    "typecheck:python": "python -m mypy hecavex_radar tests_python",
    "typecheck": "pnpm typecheck:python && pnpm typecheck:frontend",
    "test:frontend": "vitest run",
    "test:python": "python -m pytest",
    "test": "pnpm test:python && pnpm test:frontend",
    "verify:site": "node scripts/verify-site.mjs",
    "check:frontend": "pnpm lint:frontend && pnpm typecheck:frontend && pnpm test:frontend && pnpm build && pnpm verify:site",
    "check": "pnpm lint:python && pnpm typecheck:python && pnpm test:python && pnpm check:frontend"
  },
  "dependencies": {
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "jsdom": "30.0.1",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
